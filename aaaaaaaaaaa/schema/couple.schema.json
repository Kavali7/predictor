{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoupleReport",
  "type": "object",
  "required": [
    "id",
    "type",
    "locale",
    "number",
    "archetype",
    "dynamic",
    "advice"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "couple"
    },
    "locale": {
      "type": "string"
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "version": {
      "type": "integer"
    },
    "updatedAt": {
      "type": "string"
    },
    "archetype": {
      "type": "string"
    },
    "dynamic": {
      "type": "string"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blindspots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rituals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "advice": {
      "type": "string"
    }
  },
  "additionalProperties": true
}